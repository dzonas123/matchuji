generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id        String   @id
  name      String
  price     Float
  stock     Int
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ean       String?  @unique
  sku       String?  @unique
  weight_g  Int?
}

model Order {
  id                   String   @id
  date                 DateTime
  amount               Float
  status               String
  carrier              String?
  shipping             Json
  items                Json
  createdAt            DateTime @default(now())
  discount             Float?   @default(0)
  variableSymbol       String?  @unique
  zasilkovna_branch_id String?
}

model DiscountCode {
  id           String    @id @default(uuid())
  code         String    @unique
  type         String
  value        Float
  minAmount    Float?    @default(0)
  isActive     Boolean   @default(true)
  usageCount   Int       @default(0)
  maxUsages    Int?
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  freeShipping Boolean   @default(false)
}
